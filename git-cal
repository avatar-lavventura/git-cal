#!/usr/bin/env python3
"""git-cal: GitHub-style commit calendar in the terminal, Dracula theme.

Port of https://github.com/k4rthik/git-cal.

  git-cal [--period N] [--author A] [--all] [--ascii|--ansi|--unicode] [path | repo...]

  several repos (e.g. git-cal ~/git/*) are merged into one calendar; today is marked with a diamond.

  --period 1..12   show only that month (1=Jan)
  --period -11..0  show the previous -N months plus the current one
  git config calendar.{format,period,author} set defaults; CLI wins.
"""
import argparse
import os
import subprocess
import sys
from collections import Counter
from datetime import date, datetime, timedelta

MONTHS = "Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec".split()
# Dracula: current-line, purple, green, yellow, red (mirrors upstream grey/purple/green/yellow/red)
LEVELS = ["#44475a", "#bd93f9", "#50fa7b", "#f1fa8c", "#ff5555"]
COMMENT, FG, PINK, CYAN = "#6272a4", "#f8f8f2", "#ff79c6", "#8be9fd"
ASCII = [" ", ".", "o", "O", "0"]
UNICODE = ["⬚", "▢", "▤", "▣", "⬛"]
TODAY = {"ascii": "@", "unicode": "◈", "ansi": "◆"}


def paint(text, hex_color, fmt):
    if fmt != "ansi":
        return text
    r, g, b = (int(hex_color[i:i + 2], 16) for i in (1, 3, 5))
    return f"\033[38;2;{r};{g};{b}m{text}\033[0m"


def block(level, fmt, today=False):
    if today:
        return paint(TODAY[fmt], LEVELS[level] if level else FG, fmt) + " "
    if fmt == "ascii":
        return ASCII[level] + " "
    if fmt == "unicode":
        return UNICODE[level] + " "
    return paint("◼", LEVELS[level], fmt) + " "


def git_config():
    out = subprocess.run(["git", "config", "--get-regexp", r"^calendar\."],
                         capture_output=True, text=True).stdout
    pairs = (line.split(None, 1) for line in out.splitlines())
    return {kv[0][len("calendar."):]: kv[1].strip() for kv in pairs if len(kv) == 2}


def date_range(period, today):
    """[start, end) dates to display."""
    if period is None:
        return today - timedelta(days=364), today + timedelta(days=1)
    if not -11 <= period <= 12:
        sys.exit("period can only be between -11 to 0 and 1 to 12")
    if period > 0:
        year = today.year if period <= today.month else today.year - 1
        start = date(year, period, 1)
        nxt = date(year + period // 12, period % 12 + 1, 1)
        return start, min(nxt, today + timedelta(days=1))
    m = today.year * 12 + today.month - 1 + period
    return date(m // 12, m % 12 + 1, 1), today + timedelta(days=1)


def compute_stats(days, counts):
    """days: chronological list of dates; counts: Counter date->commits."""
    s = dict(total=sum(counts[d] for d in days), cur=0, cur_start=None, max=0, max_range=None,
             wcur=0, wcur_start=None, wmax=0, wmax_range=None)
    for d in days:
        if counts[d]:
            s["cur"] += 1
            s["cur_start"] = s["cur_start"] or d
            if s["cur"] > s["max"]:
                s["max"], s["max_range"] = s["cur"], (s["cur_start"], d)
            # weekday streak: a commit on a weekend counts, an empty weekend does not break it
            s["wcur"] += 1
            s["wcur_start"] = s["wcur_start"] or d
            if s["wcur"] > s["wmax"]:
                s["wmax"], s["wmax_range"] = s["wcur"], (s["wcur_start"], d)
        else:
            s["cur"], s["cur_start"] = 0, None
            if d.weekday() < 5:
                s["wcur"], s["wcur_start"] = 0, None
    distinct = sorted({counts[d] for d in days if counts[d]}) or [0]
    n = len(distinct)
    s["q"] = (distinct[n // 4], distinct[n // 2], distinct[min(3 * n // 4, n - 1)])
    return s


def level(v, q):
    return 0 if v == 0 else 1 if v <= q[0] else 2 if v <= q[1] else 3 if v <= q[2] else 4


def render(start, end, counts, fmt):
    first_sunday = start - timedelta(days=(start.weekday() + 1) % 7)
    ncols = (end - timedelta(days=1) - first_sunday).days // 7 + 1
    days = [start + timedelta(days=i) for i in range((end - start).days)]
    s = compute_stats(days, counts)

    # month labels at the column holding the 1st, skipped if they would overlap
    labels = [" "] * (ncols * 2 + 4)
    for d in days:
        col = (d - first_sunday).days // 7
        if (d.day == 1 or d == start) and all(c == " " for c in labels[col * 2:col * 2 + 4]):
            labels[col * 2:col * 2 + 3] = MONTHS[d.month - 1]
    out = [" " * 6 + paint("".join(labels).rstrip(), COMMENT, fmt)]

    for row in range(7):
        line = " " * 4 + paint({1: "M ", 3: "W ", 5: "F "}.get(row, "  "), COMMENT, fmt)
        for col in range(ncols):
            d = first_sunday + timedelta(days=col * 7 + row)
            line += block(level(counts[d], s["q"]), fmt, d == date.today()) if start <= d < end else "  "
        out.append(line.rstrip())

    legend = paint("Less ", COMMENT, fmt) + "".join(block(i, fmt) for i in range(5)) + paint("More", COMMENT, fmt)
    out += ["", " " * max(6 + 2 * ncols - 19, 0) + legend]
    out.append(paint(f"{s['total']:4d}", PINK, fmt) + ": Total commits")

    def msg(n, rng, text):
        if not n:
            return paint(f"{n:4d}", PINK, fmt) + f": Days - {text}"
        span = " - ".join(f"{MONTHS[x.month - 1]} {x.day:2d} {x.year}" for x in rng)
        return paint(f"{n:4d}", PINK, fmt) + ": Days ( " + paint(f"{span:<25s}", CYAN, fmt) + f" ) - {text}"

    out.append(msg(s["wmax"], s["wmax_range"], "Longest streak excluding weekends"))
    out.append(msg(s["max"], s["max_range"], "Longest streak including weekends"))
    out.append(msg(s["wcur"], (s["wcur_start"], date.today()), "Current streak"))
    return "\n".join(out)


def main():
    p = argparse.ArgumentParser(prog="git-cal", description="View commits calendar on the command line.")
    p.add_argument("-p", "--period", type=int)
    p.add_argument("--author")
    p.add_argument("--all", action="store_true", help="all branches")
    g = p.add_mutually_exclusive_group()
    for f in ("ascii", "ansi", "unicode"):
        g.add_argument(f"--{f}", dest="format", action="store_const", const=f)
    p.add_argument("paths", nargs="*", help="a file/dir to filter on, or several repos to merge")
    a = p.parse_args()

    cfg = git_config()
    period = a.period if a.period is not None else (int(cfg["period"]) if "period" in cfg else None)
    author = a.author or cfg.get("author")
    fmt = a.format or cfg.get("format") or (
        "unicode" if os.environ.get("EMACS") else "ascii" if os.environ.get("TERM") == "dumb" else "ansi")

    log = ["log", "--no-merges", "--pretty=format:%at", "--since=13 months"]
    if author:
        log.append(f"--author={author}")
    if a.all:
        log.append("--all")

    # any arg that is a repo => merge all repo args (non-repos skipped, so `git-cal ~/git/*` works)
    repos = [d for d in a.paths if os.path.exists(os.path.join(d, ".git"))]
    if repos:
        runs = [subprocess.run(["git", "-C", d] + log, capture_output=True, text=True) for d in repos]
        out = "\n".join(r.stdout for r in runs if not r.returncode)  # skip broken/empty repos
    else:
        if len(a.paths) > 1:
            sys.exit("fatal: give one file/dir filter, or several git repos")
        if a.paths:
            if not os.path.exists(a.paths[0]):
                sys.exit(f"fatal: {a.paths[0]}: no such file or directory")
            log += ["--", a.paths[0]]
        r = subprocess.run(["git"] + log, capture_output=True, text=True)
        if r.returncode:
            print("fatal: git-cal failed to get the git log")
            sys.exit(2)
        out = r.stdout
    if not out.strip():
        print("git-cal: got empty log, nothing to do")
        sys.exit(1)

    counts = Counter(datetime.fromtimestamp(int(t)).date() for t in out.split())
    start, end = date_range(period, date.today())
    print(render(start, end, counts, fmt))


if __name__ == "__main__":
    main()
